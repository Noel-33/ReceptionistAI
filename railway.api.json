{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run railway:build:api",
    "watchPatterns": [
      "apps/api/**",
      "packages/**",
      "prisma/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "tsconfig.base.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "npm run railway:db:push",
    "startCommand": "npm run railway:start:api",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
