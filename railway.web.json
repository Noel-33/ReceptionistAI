{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run railway:build:web",
    "watchPatterns": [
      "apps/web/**",
      "packages/**",
      "package.json",
      "package-lock.json",
      "tsconfig.base.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run railway:start:web",
    "healthcheckPath": "/signin",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
